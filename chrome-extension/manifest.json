{
  "manifest_version": 3,
  "name": "Pastily для Chrome",
  "version": "0.1.0",
  "description": "Добавляет к локальной истории Pastily домен и заголовок страницы.",
  "permissions": ["nativeMessaging", "storage"],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content-script.js"], "run_at": "document_start" }],
  "action": { "default_title": "Состояние Pastily", "default_popup": "status.html" }
}
