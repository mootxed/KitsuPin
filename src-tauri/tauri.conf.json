{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KitsuPin",
  "version": "0.1.4",
  "identifier": "io.github.mootxed.kitsupin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{
      "label": "main",
      "title": "KitsuPin",
      "width": 1180,
      "height": 780,
      "minWidth": 720,
      "minHeight": 560,
      "visible": false,
      "center": true
    }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:" }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "shortDescription": "Локальная история буфера обмена",
    "longDescription": "KitsuPin сохраняет текст и растровые изображения из обычного X11 Clipboard и показывает историю через KDE tray.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/256x256.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/kitsupin/kitsupin-native-host": "target/release/kitsupin-native-host",
          "/etc/xdg/autostart/kitsupin.desktop": "../packaging/kitsupin-autostart.desktop",
          "/usr/lib/kitsupin/resources/chrome-extension": "../chrome-extension",
          "/usr/lib/kitsupin/resources/scripts/uninstall-user-data.sh": "../scripts/uninstall-user-data.sh"
        },
        "preInstallScript": "../packaging/preinst"
      }
    },
    "resources": {}
  }
}
