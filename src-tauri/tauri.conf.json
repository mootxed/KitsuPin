{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pastily",
  "version": "0.1.0",
  "identifier": "app.pastily.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{
      "label": "main",
      "title": "Pastily",
      "width": 1180,
      "height": 780,
      "minWidth": 820,
      "minHeight": 560,
      "visible": false,
      "center": true
    }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:" }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "shortDescription": "Локальная история буфера обмена",
    "longDescription": "Pastily сохраняет текст из обычного X11 Clipboard и показывает историю через KDE tray.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/256x256.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "files": {
          "/etc/xdg/autostart/pastily.desktop": "../packaging/pastily-autostart.desktop"
        }
      }
    },
    "resources": {
      "../chrome-extension/": "chrome-extension/",
      "../scripts/install-native-host.sh": "scripts/install-native-host.sh",
      "../scripts/native-host-manifest.template.json": "scripts/native-host-manifest.template.json",
      "../scripts/uninstall-user-data.sh": "scripts/uninstall-user-data.sh"
    }
  }
}
